{
  "name": "VolumeExplorer",
  "display_name": "Volume Explorer",
  "description": "Slice, transfer function, depth transect, and coarse 3D volume with optional streamlines",
  "version": "1.0.0",
  "type": "dash",
  "entry_point": "VolumeExplorer.py",
  "entry_point_type": "python",
  "port": 8065,
  "base_image": "sc-plotly-dashboard-base",
  "base_image_tag": "latest",
  "requirements_file": "requirements.txt",
  "additional_requirements": [
    "dash",
    "dash-bootstrap-components",
    "dash_vtk",
    "vtk",
    "dash-vtk",
    "plotly",
    "numpy"
  ],
  "shared_utilities": [
    "mongo_connection.py",
    "utils_bokeh_mongodb.py",
    "utils_bokeh_dashboard.py",
    "utils_bokeh_auth.py",
    "utils_bokeh_param.py",
    "SCDash_dataset_resolver.py",
    "SCDash_openvisus_load.py",
    "SCDash_volume_explorer.py"
  ],
  "environment_variables": {
    "SECRET_KEY": "${SECRET_KEY}",
    "DEPLOY_SERVER": "${DEPLOY_SERVER}",
    "DB_NAME": "${DB_NAME}",
    "MONGO_URL": "${MONGO_URL}"
  },
  "nginx_path": "/dashboard/VolumeExplorer",
  "app_path": "/VolumeExplorer/",
  "health_check_path": "/health",
  "supported_dimensions": ["3D", "4D"],
  "build_args": {
    "D_GIT_TOKEN": "${D_GIT_TOKEN}"
  },
  "volume_mounts": [],
  "exposed_ports": [8065],
  "depends_on": [],
  "enabled": true
}
