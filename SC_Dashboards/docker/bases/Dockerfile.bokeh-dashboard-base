# ScientistCloud Bokeh/Panel dashboard base (replaces visstore-bokeh-dashboard-base from VisusDataPortalPrivate)
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=True \
    TZ=America/Chicago \
    INSTALL_HOME=/home/scientistcloud \
    PYTHONPATH=${INSTALL_HOME}/dataportal/openvisuspy/src

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git curl gcc gfortran libopenblas-dev liblapack-dev pkg-config patchelf passwd \
    && python3 -m pip install --upgrade pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY requirements/ /tmp/requirements/

RUN python3 -m pip install --no-cache-dir -r /tmp/requirements/base-requirements.txt && \
    python3 -m pip install --no-cache-dir -r /tmp/requirements/ubuntu-python310-requirements.txt && \
    python3 -m pip install --no-cache-dir -r /tmp/requirements/bokeh-requirements.txt && \
    python3 -m OpenVisus configure || true

# PyPI openvisuspy==1.0.71 lacks GetBackend/Slices (OpenVisusSlice needs git source).
# Same pin as legacy visstore-bokeh-dashboard-base (VisusDataPortalPrivate).
RUN git clone https://github.com/sci-visus/openvisuspy.git ${INSTALL_HOME}/dataportal/openvisuspy && \
    cd ${INSTALL_HOME}/dataportal/openvisuspy && \
    git checkout c1c8340cd015f04bc431b904a2bdfc0901cc34b0 && \
    python3 -m pip uninstall -y openvisuspy 2>/dev/null || true && \
    python3 -m pip install --no-cache-dir -e ${INSTALL_HOME}/dataportal/openvisuspy

RUN mkdir -p ${INSTALL_HOME} /app /srv/tmp && \
    (id -u bokehuser >/dev/null 2>&1 || useradd -m -s /bin/bash -u 10001 bokehuser) && \
    chown -R bokehuser:bokehuser /app ${INSTALL_HOME} /srv/tmp

WORKDIR /app
USER bokehuser
