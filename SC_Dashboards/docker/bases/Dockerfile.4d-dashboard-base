# ScientistCloud 4D Bokeh dashboard base (replaces visstore-4d-dashboard-base)
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=True \
    TZ=America/Chicago \
    INSTALL_HOME=/home/scientistcloud \
    PYTHONPATH="/usr/local/lib/python3.10/site-packages:/app/src" \
    OPENVISUSPY_DASHBOARDS_LOG_FILENAME=/srv/tmp/openvisuspy-dashboards.log

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        git vim fuse procps bash ca-certificates build-essential cmake ninja-build python3-dev \
        pybind11-dev libgomp1 libjpeg-dev libpng-dev libtiff-dev libopenjp2-7-dev libwebp-dev \
        zlib1g-dev libffi-dev libssl-dev curl wget unzip patchelf passwd \
        gcc gfortran libopenblas-dev liblapack-dev pkg-config \
    && python3 -m pip install --upgrade pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY requirements/ /tmp/requirements/

RUN python3 -m pip install --no-cache-dir -r /tmp/requirements/base-requirements.txt && \
    python3 -m pip install --no-cache-dir -r /tmp/requirements/ubuntu-python310-requirements.txt && \
    python3 -m pip install --no-cache-dir -r /tmp/requirements/bokeh-requirements.txt && \
    python3 -m OpenVisus configure || true

RUN mkdir -p ${INSTALL_HOME} /app /srv/tmp && \
    (id -u bokehuser >/dev/null 2>&1 || useradd -m -s /bin/bash -u 10001 bokehuser) && \
    chown -R bokehuser:bokehuser /app ${INSTALL_HOME} /srv/tmp

WORKDIR /app
USER bokehuser
EXPOSE 5009
